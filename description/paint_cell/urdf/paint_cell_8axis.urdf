  <!-- 스프레이건 툴 어셈블리 (Spraygun_full_assy.stp에서 변환, 시각화 전용).
       메시는 link_6 프레임: TCV1 툴체인저 접속면 중심=원점, +z=플랜지 바깥. 단위 m. -->
  <link name="tool_assy">
    <visual><origin xyz="0 0 0" rpy="0 0 0" /><geometry><mesh filename="package://paint_viz/urdf/tool_assy.stl" /></geometry><material name="dr_gray" /></visual>
  </link>
  <joint name="flange_to_tool" type="fixed"><parent link="link_6" /><child link="tool_assy" /><origin xyz="0 0 0" rpy="0 0 0" /></joint>
  <!-- 스프레이건: 툴의 T-block Ø24 수직 보어에 손잡이 튜브가 물리고, 건 본체·노즐은 툴 끝(+Z_assy, 플랜지에서 먼 쪽)에 있다.
       spray_gun 프레임 = 노즐 팁 원점(link_6 기준 +z 0.297 m), +z=분사 방향. 아래 tcp 프레임이 이를 TCP 로 노출한다. -->
  <link name="spray_gun">
    <visual><origin xyz="0 0 0" rpy="0 0 0" /><geometry><mesh filename="package://paint_viz/urdf/spray_gun.stl" /></geometry><material name="dr_gray" /></visual>
  </link>
  <joint name="tool_to_gun" type="fixed"><parent link="link_6" /><child link="spray_gun" /><origin xyz="0.129200 -0.060700 0.296900" rpy="0 0 0" /></joint>
  <!-- TCP = 노즐 팁. spray_gun 원점(메시 최상단 정점 (0,0,0))과 같은 곳, +z=분사 방향.
       모든 IK/NLP/stitch/재생의 기본 tcp-frame 'auto' 가 이 프레임을 먼저 고른다. -->
  <link name="tcp" /><joint name="spray_gun_to_tcp" type="fixed"><parent link="spray_gun" /><child link="tcp" /><origin xyz="0 0 0" rpy="0 0 0" /></joint>
</robot>